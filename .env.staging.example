APP_ENV=staging
POSTGRES_DB=jantok_staging
POSTGRES_USER=jantok_staging
POSTGRES_PASSWORD=REPLACE_FROM_SECRET_STORE
DATABASE_URL=postgresql://jantok_staging:REPLACE_FROM_SECRET_STORE@postgres:5432/jantok_staging?schema=public
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=REPLACE_FROM_SECRET_STORE
MINIO_ROOT_PASSWORD=REPLACE_FROM_SECRET_STORE
S3_ENDPOINT=https://REPLACE_STORAGE_ENDPOINT
S3_REGION=REPLACE_REGION
S3_BUCKET=REPLACE_STAGING_BUCKET
S3_ACCESS_KEY_ID=REPLACE_FROM_SECRET_STORE
S3_SECRET_ACCESS_KEY=REPLACE_FROM_SECRET_STORE
JWT_ACCESS_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_RANDOM_CHARACTERS
SESSION_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_RANDOM_CHARACTERS
OTP_HASH_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_RANDOM_CHARACTERS
PII_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_IP=20
OTP_RATE_LIMIT_PER_DEVICE=10
OTP_PROVIDER_MODE=unconfigured
PAYMENT_PROVIDER_MODE=unconfigured
FISCALIZATION_PROVIDER_MODE=unconfigured
DELIVERY_PROVIDER_MODE=unconfigured
DELIVERY_PICKUP_ADDRESS=REPLACE_STAGING_KITCHEN_ADDRESS
DELIVERY_PICKUP_LATITUDE=REPLACE_WGS84_LATITUDE
DELIVERY_PICKUP_LONGITUDE=REPLACE_WGS84_LONGITUDE
PUSH_PROVIDER_MODE=unconfigured
PAYMENT_MAINTENANCE_INTERVAL_SECONDS=60
DELIVERY_MAINTENANCE_INTERVAL_SECONDS=60
CORS_ORIGINS=https://REPLACE_STAGING_DOMAIN
NEXT_PUBLIC_API_BASE_URL=https://REPLACE_STAGING_DOMAIN/api/v1
JANTOK_DOMAIN=REPLACE_STAGING_DOMAIN
SUPER_ADMIN_PHONE_1=REPLACE_E164
SUPER_ADMIN_PHONE_2=REPLACE_DIFFERENT_E164
DEMO_SEED_ENABLED=false
