  aggregateId    String       @map("aggregate_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(100)
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(160)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError      String?      @map("last_error") @db.VarChar(1000)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("payment_outbox")
}

model RenewalJob {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId    String        @map("subscription_id") @db.Uuid
  paymentMethodId   String        @map("payment_method_id") @db.Uuid
  cycleEndDate      DateTime      @map("cycle_end_date") @db.Date
  expectedChargeAt  DateTime      @map("expected_charge_at") @db.Timestamptz(3)
  notificationDueAt DateTime      @map("notification_due_at") @db.Timestamptz(3)
  notifiedAt        DateTime?     @map("notified_at") @db.Timestamptz(3)
  priceKzt          Int           @map("price_kzt")
  pricingSnapshot   Json          @map("pricing_snapshot")
  termsVersion      String        @map("terms_version") @db.VarChar(80)
  status            RenewalStatus @default(SCHEDULED)
  attempts          Int           @default(0)
  maxAttempts       Int           @default(3) @map("max_attempts")
  nextAttemptAt     DateTime?     @map("next_attempt_at") @db.Timestamptz(3)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(160)
