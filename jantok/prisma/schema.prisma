model User {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                  String                  @unique @db.VarChar(20)
  firstName              String                  @map("first_name") @db.VarChar(100)
  lastName               String                  @map("last_name") @db.VarChar(100)
  status                 UserStatus              @default(ACTIVE)
  locale                 String                  @default("kk") @db.VarChar(5)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  version                Int                     @default(0)
  household              Household?
  sessions               UserSession[]
  deviceTokens           DeviceToken[]
  employee               Employee?
  mealReviews            MealReview[]
  referralCode           String?                 @unique @map("referral_code") @db.VarChar(32)
  referralsSent          Referral[]              @relation("ReferralReferrer")
  referralInvite         Referral?               @relation("ReferralInvitee")
  supportThreads         SupportThread[]         @relation("SupportThreadOwner")
  supportMessages        SupportMessage[]
  notificationPreference NotificationPreference?
  notificationOutbox     NotificationOutbox[]

  @@index([status, createdAt])
  @@map("users")
}

model OtpChallenge {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone         String    @db.VarChar(20)
  codeHash      String    @map("code_hash") @db.VarChar(128)
  deviceId      String    @map("device_id") @db.VarChar(128)
  requestIp     String    @map("request_ip") @db.Inet
  attempts      Int       @default(0)
  maxAttempts   Int       @map("max_attempts")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  resendAfter   DateTime  @map("resend_after") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([expiresAt, consumedAt])
  @@map("otp_challenges")
}

model UserSession {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  deviceId          String             @map("device_id") @db.VarChar(128)
  deviceName        String?            @map("device_name") @db.VarChar(160)
  refreshTokenHash  String             @unique @map("refresh_token_hash") @db.VarChar(128)
  refreshVersion    Int                @default(0) @map("refresh_version")
  userAgent         String?            @map("user_agent") @db.VarChar(512)
  ipAddress         String?            @map("ip_address") @db.Inet
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(3)
  lastUsedAt        DateTime?          @map("last_used_at") @db.Timestamptz(3)
  revokedAt         DateTime?          @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String?            @map("revocation_reason") @db.VarChar(120)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceTokens      DeviceToken[]
  usedRefreshTokens UsedRefreshToken[]

  @@index([userId, expiresAt])
  @@index([userId, deviceId, revokedAt])
  @@index([expiresAt, revokedAt])
  @@map("user_sessions")
}

model UsedRefreshToken {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  tokenHash String      @unique @map("token_hash") @db.VarChar(128)
  usedAt    DateTime    @default(now()) @map("used_at") @db.Timestamptz(3)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("used_refresh_tokens")
}

model DeviceToken {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  sessionId      String      @map("session_id") @db.Uuid
  tokenHash      String      @unique @map("token_hash") @db.VarChar(128)
  encryptedToken String      @map("encrypted_token") @db.VarChar(2048)
  platform       String      @db.VarChar(16)
  deviceId       String      @map("device_id") @db.VarChar(128)
  locale         String      @default("kk") @db.VarChar(5)
  lastSeenAt     DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  session        UserSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, deviceId])
  @@index([userId, revokedAt])
  @@map("device_tokens")
}

model Household {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId           String                      @unique @map("owner_user_id") @db.Uuid
  name                  String?                     @db.VarChar(120)
  timezone              String                      @default("Asia/Almaty") @db.VarChar(64)
  onboardingStep        OnboardingStep              @default(FAMILY) @map("onboarding_step")
  onboardingCompletedAt DateTime?                   @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  version               Int                         @default(0)
  owner                 User                        @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  members               HouseholdMember[]
  addresses             HouseholdAddress[]
  quotes                PriceQuote[]
  purchases             Purchase[]
  subscriptions         Subscription[]
  guests                SubscriptionGuest[]
  paymentMethods        PaymentMethod[]
  bonusEntries          BonusLedgerEntry[]
  bonusReservations     BonusReservation[]
  promoReservations     PromoReservation[]
  clubMembership        ClubMembership?
  recurringAddonPlans   RecurringAddonPlan[]
  dailyFulfillments     DailyFulfillment[]
  serviceDayOverrides   ServiceDayAddressOverride[]
  supportThreads        SupportThread[]

  @@map("households")
}

model HouseholdAddress {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId          String                      @map("household_id") @db.Uuid
  label                String                      @default("Дом") @db.VarChar(80)
  city                 String                      @default("Астана") @db.VarChar(80)
  streetAddress        String                      @map("street_address") @db.VarChar(240)
  apartment            String?                     @db.VarChar(32)
  entrance             String?                     @db.VarChar(32)
  floor                String?                     @db.VarChar(16)
  intercom             String?                     @db.VarChar(32)
  deliveryInstructions String?                     @map("delivery_instructions") @db.VarChar(500)
  landmarks            String?                     @db.VarChar(500)
  latitude             Decimal?                    @db.Decimal(9, 6)
  longitude            Decimal?                    @db.Decimal(9, 6)
  windowStart          DateTime?                   @map("window_start") @db.Time(0)
  windowEnd            DateTime?                   @map("window_end") @db.Time(0)
  isDefault            Boolean                     @default(true) @map("is_default")
  deliverySlotId       String?                     @map("delivery_slot_id") @db.Uuid
  version              Int                         @default(0)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  household            Household                   @relation(fields: [householdId], references: [id], onDelete: Restrict)
  quotes               PriceQuote[]
  deliverySlot         DeliverySlot?               @relation(fields: [deliverySlotId], references: [id], onDelete: Restrict)
  serviceDayOverrides  ServiceDayAddressOverride[]

  @@index([householdId, deletedAt])
  @@map("household_addresses")
}

model HouseholdMember {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId     String                    @map("household_id") @db.Uuid
  firstName       String                    @map("first_name") @db.VarChar(100)
  birthDate       DateTime?                 @map("birth_date") @db.Date
  status          MemberStatus              @default(ACTIVE)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  version         Int                       @default(0)
  household       Household                 @relation(fields: [householdId], references: [id], onDelete: Restrict)
  profile         MemberProfile?
  allergies       MemberAllergy[]
  foodPreferences MemberFoodPreference[]
  sports          MemberSport[]
  recommendations NutritionRecommendation[]
  mealSelections  MemberMealSelection[]
  staffTasks      StaffTask[]
  quoteLines      PriceQuoteLine[]
  participants    SubscriptionParticipant[]
  dailyOrders     DailyOrder[]
  changeQuotes    SubscriptionChangeQuote[]
  mealReviews     MealReview[]

  @@index([householdId, status])
  @@map("household_members")
}

model MemberProfile {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId                 String                   @unique @map("member_id") @db.Uuid
  biologicalSex            BiologicalSex            @default(UNSPECIFIED) @map("biological_sex")
  heightCm                 Decimal?                 @map("height_cm") @db.Decimal(5, 2)
  weightKg                 Decimal?                 @map("weight_kg") @db.Decimal(6, 2)
  activityLevelId          String?                  @map("activity_level_id") @db.Uuid
  sportIntensity           SportIntensity           @default(NONE) @map("sport_intensity")
  sportHoursPerWeek        Decimal                  @default(0) @map("sport_hours_per_week") @db.Decimal(4, 1)
  sportNotes               String?                  @map("sport_notes") @db.VarChar(500)
  goal                     GoalType?
  dietTypeId               String?                  @map("diet_type_id") @db.Uuid
  allergyDeclarationStatus AllergyDeclarationStatus @default(NOT_ANSWERED) @map("allergy_declaration_status")
  portionPreference        PortionPreference        @default(RECOMMENDED) @map("portion_preference")
  questionnaireCompletedAt DateTime?                @map("questionnaire_completed_at") @db.Timestamptz(3)
  notes                    String?                  @db.VarChar(1000)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                  Int                      @default(0)
  member                   HouseholdMember          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  activityLevel            ActivityLevel?           @relation(fields: [activityLevelId], references: [id], onDelete: Restrict)
  dietType                 DietType?                @relation(fields: [dietTypeId], references: [id], onDelete: Restrict)

  @@map("member_profiles")
}

model ActivityLevel {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String          @unique @db.VarChar(64)
  nameKk         String          @map("name_kk") @db.VarChar(120)
  nameRu         String          @map("name_ru") @db.VarChar(120)
  nameEn         String          @map("name_en") @db.VarChar(120)
  sortOrder      Int             @default(0) @map("sort_order")
  active         Boolean         @default(true)
  memberProfiles MemberProfile[]

  @@map("activity_levels")
}

model SportType {
  id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code    String        @unique @db.VarChar(64)
  nameKk  String        @map("name_kk") @db.VarChar(120)
  nameRu  String        @map("name_ru") @db.VarChar(120)
  nameEn  String        @map("name_en") @db.VarChar(120)
  active  Boolean       @default(true)
  members MemberSport[]

  @@map("sport_types")
}

model MemberSport {
  memberId    String          @map("member_id") @db.Uuid
  sportTypeId String          @map("sport_type_id") @db.Uuid
  member      HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sportType   SportType       @relation(fields: [sportTypeId], references: [id], onDelete: Restrict)

  @@id([memberId, sportTypeId])
  @@map("member_sports")
}

model DietType {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String                @unique @db.VarChar(64)
  nameKk         String                @map("name_kk") @db.VarChar(120)
  nameRu         String                @map("name_ru") @db.VarChar(120)
  nameEn         String                @map("name_en") @db.VarChar(120)
  requiresHalal  Boolean               @default(true) @map("requires_halal")
  active         Boolean               @default(true)
  memberProfiles MemberProfile[]
  excludedTags   DietTypeExcludedTag[]

  @@map("diet_types")
}

model IngredientTag {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                @unique @db.VarChar(64)
  ingredients IngredientTagLink[]
  dietTypes   DietTypeExcludedTag[]

  @@map("ingredient_tags")
}

model DietTypeExcludedTag {
  dietTypeId String        @map("diet_type_id") @db.Uuid
  tagId      String        @map("tag_id") @db.Uuid
  dietType   DietType      @relation(fields: [dietTypeId], references: [id], onDelete: Restrict)
  tag        IngredientTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([dietTypeId, tagId])
  @@map("diet_type_excluded_tags")
}

model Allergen {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String               @unique @db.VarChar(64)
  nameKk          String               @map("name_kk") @db.VarChar(120)
  nameRu          String               @map("name_ru") @db.VarChar(120)
  nameEn          String               @map("name_en") @db.VarChar(120)
  active          Boolean              @default(true)
  ingredients     IngredientAllergen[]
  memberAllergies MemberAllergy[]
  mealRisks       MealAllergenRisk[]

  @@map("allergens")
}

model MemberAllergy {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String          @map("member_id") @db.Uuid
  allergenId     String?         @map("allergen_id") @db.Uuid
  freeText       String?         @map("free_text") @db.VarChar(500)
  requiresReview Boolean         @default(false) @map("requires_review")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  member         HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  allergen       Allergen?       @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@unique([memberId, allergenId])
  @@index([memberId, requiresReview])
  @@map("member_allergies")
