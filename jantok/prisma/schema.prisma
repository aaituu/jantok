}

model PrintDocument {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              PrintDocumentType
  revisionId        String?             @map("revision_id") @db.Uuid
  packingTaskId     String?             @map("packing_task_id") @db.Uuid
  reprintOfId       String?             @map("reprint_of_id") @db.Uuid
  idempotencyKey    String              @unique @map("idempotency_key") @db.VarChar(180)
  fileName          String              @map("file_name") @db.VarChar(240)
  pageSize          String              @map("page_size") @db.VarChar(40)
  contentSnapshot   Json                @map("content_snapshot")
  htmlContent       String              @map("html_content") @db.Text
  sha256            String              @db.Char(64)
  generatedByUserId String              @map("generated_by_user_id") @db.Uuid
  generatedAt       DateTime            @default(now()) @map("generated_at") @db.Timestamptz(3)
  revision          ProductionRevision? @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  packingTask       PackingTask?        @relation(fields: [packingTaskId], references: [id], onDelete: Restrict)
  reprintOf         PrintDocument?      @relation("PrintHistory", fields: [reprintOfId], references: [id], onDelete: Restrict)
  reprints          PrintDocument[]     @relation("PrintHistory")

  @@index([type, generatedAt])
  @@map("print_documents")
}
