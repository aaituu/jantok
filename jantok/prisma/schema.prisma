model StorageLocation {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String                 @unique @db.VarChar(64)
  name                  String                 @db.VarChar(160)
  active                Boolean                @default(true)
  balances              InventoryBalance[]
  sourceMovements       InventoryMovement[]    @relation("MovementSource")
  targetMovements       InventoryMovement[]    @relation("MovementTarget")
  purchaseItems         SupplierPurchaseItem[]
  inventoryReservations InventoryReservation[]

  @@map("storage_locations")
}

model InventoryBalance {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId      String          @map("ingredient_id") @db.Uuid
  storageLocationId String          @map("storage_location_id") @db.Uuid
  onHandQuantity    Decimal         @default(0) @map("on_hand_quantity") @db.Decimal(16, 3)
  reservedQuantity  Decimal         @default(0) @map("reserved_quantity") @db.Decimal(16, 3)
  averageCostKzt    Decimal         @default(0) @map("average_cost_kzt") @db.Decimal(16, 6)
  version           Int             @default(0)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  ingredient        Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)

  @@unique([ingredientId, storageLocationId])
  @@index([storageLocationId, onHandQuantity])
  @@map("inventory_balances")
}

model InventoryMovement {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId     String                @map("ingredient_id") @db.Uuid
  type             InventoryMovementType
  quantity         Decimal               @db.Decimal(16, 3)
  canonicalUnit    String                @map("canonical_unit") @db.VarChar(16)
  sourceLocationId String?               @map("source_location_id") @db.Uuid
  targetLocationId String?               @map("target_location_id") @db.Uuid
  unitCostKzt      Decimal               @map("unit_cost_kzt") @db.Decimal(16, 6)
  totalCostKzt     Decimal               @map("total_cost_kzt") @db.Decimal(18, 2)
  idempotencyKey   String                @unique @map("idempotency_key") @db.VarChar(180)
  referenceType    String                @map("reference_type") @db.VarChar(64)
  referenceId      String                @map("reference_id") @db.VarChar(180)
  reason           String?               @db.VarChar(500)
  actorUserId      String?               @map("actor_user_id") @db.Uuid
  shiftCode        String?               @map("shift_code") @db.VarChar(80)
  recipeSnapshot   Json?                 @map("recipe_snapshot")
  occurredAt       DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  ingredient       Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  sourceLocation   StorageLocation?      @relation("MovementSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  targetLocation   StorageLocation?      @relation("MovementTarget", fields: [targetLocationId], references: [id], onDelete: Restrict)
  wasteEntry       WasteEntry?

  @@index([ingredientId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model Supplier {
