model ProductionRevision {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceDate       DateTime                   @map("service_date") @db.Date
  revision          Int
  kind              ProductionRevisionKind
  status            ProductionRevisionStatus   @default(DRAFT)
  basedOnRevisionId String?                    @map("based_on_revision_id") @db.Uuid
  idempotencyKey    String                     @unique @map("idempotency_key") @db.VarChar(180)
  lockedAt          DateTime?                  @map("locked_at") @db.Timestamptz(3)
  completedAt       DateTime?                  @map("completed_at") @db.Timestamptz(3)
  actorUserId       String?                    @map("actor_user_id") @db.Uuid
  reason            String?                    @db.VarChar(500)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  basedOnRevision   ProductionRevision?        @relation("ProductionRevisionChain", fields: [basedOnRevisionId], references: [id], onDelete: Restrict)
  deltaRevisions    ProductionRevision[]       @relation("ProductionRevisionChain")
  lines             ProductionLine[]
  ingredientNeeds   ProductionIngredientNeed[]
  reservations      InventoryReservation[]
  packingTasks      PackingTask[]
  printDocuments    PrintDocument[]
  productionRun     ProductionRun?

  @@unique([serviceDate, revision])
  @@index([serviceDate, status])
  @@map("production_revisions")
}

model ProductionLine {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId           String               @map("revision_id") @db.Uuid
  lineKind             String               @default("MEAL") @map("line_kind") @db.VarChar(16)
  itemId               String               @map("item_id") @db.Uuid
  itemCode             String               @map("item_code") @db.VarChar(80)
  variantKey           String               @map("variant_key") @db.VarChar(64)
  portionKey           String               @map("portion_key") @db.VarChar(80)
  plannedQuantity      Int                  @map("planned_quantity")
  actualQuantity       Int?                 @map("actual_quantity")
  status               ProductionLineStatus @default(PLANNED)
  itemSnapshot         Json                 @map("item_snapshot")
  recipeSnapshot       Json                 @map("recipe_snapshot")
  modificationSnapshot Json                 @map("modification_snapshot")
  restrictionSnapshot  Json                 @map("restriction_snapshot")
  estimatedCostKzt     Decimal              @default(0) @map("estimated_cost_kzt") @db.Decimal(18, 2)
  actualCostKzt        Decimal?             @map("actual_cost_kzt") @db.Decimal(18, 2)
  version              Int                  @default(0)
  revision             ProductionRevision   @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([revisionId, variantKey])
  @@index([revisionId, status])
  @@map("production_lines")
}

